#!/usr/bin/env python3
"""Interactive bookmarks stored in a single Obsidian Markdown note."""
import argparse
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import date
import fcntl
from html.parser import HTMLParser
import os
import pwd
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

USER_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
FILE = Path(os.environ.get('TABBER_FILE', str(USER_HOME / 'documents/notes/tabber.md')))
HEADER = '# Tabber\n\nSaved links. Edit titles, dates, tags, or add indented notes inside each entry.\nTabber matches bookmarks by URL. Keep annotations indented beneath their bookmark.\n\n'
DELETED_NOTICE = '  *Deleted — excluded from Tabber search.*\n'
LINK = re.compile(r'^- \[((?:\\.|[^\\\]])*)\]\((?:<([^\n<>]+)>|([^\n]+))\)[ \t]*$')
METADATA = re.compile(r'^  added: (\d{4}-\d{2}-\d{2})[ \t]*·[ \t]*(.*)$')


class Cancelled(Exception):
    pass


@dataclass
class Entry:
    url: str
    title: str
    added: str
    tags: list
    deleted: bool = False
    notes: str = ''
    start: int = 0
    end: int = 0


def clean(value):
    return ' '.join(value.split())


def tags_from(value):
    tags = []
    for tag in value.split(','):
        tag = tag.strip().lstrip('#')
        if tag.startswith('tabber/'):
            tag = tag[7:]
        if not tag:
            continue
        if not re.fullmatch(r'[\w/-]+', tag) or not re.search(r'[^\d/]', tag):
            raise ValueError(f'Invalid tag: {tag}. Use letters, underscores, hyphens or slashes.')
        if tag not in tags:
            tags.append(tag)
    return tags


def check_url(url):
    parsed = urlsplit(url)
    if parsed.scheme not in ('http', 'https') or not parsed.netloc or re.search(r'[\s<>]', url):
        raise ValueError('URL must be a single http:// or https:// address.')
    return url


def render(entry):
    title = entry.title.replace('\\', '\\\\')
    for char in '[]*_`':
        title = title.replace(char, '\\' + char)
    tags = ' '.join('#tabber/' + t if t.lower() in ('todo', 'archive') else '#' + t for t in entry.tags)
    return (f'- [{title}](<{entry.url}>)\n'
            f'  added: {entry.added} · {tags}\n'
            f'{DELETED_NOTICE if entry.deleted else ""}{entry.notes}')


def parse(text):
    """Read link bullets and their indented metadata/annotations, without IDs."""
    entries = []
    lines = text.splitlines(keepends=True)
    offsets = [0]
    for line in lines:
        offsets.append(offsets[-1] + len(line))
    i = 0
    while i < len(lines):
        link = LINK.fullmatch(lines[i].rstrip('\r\n'))
        if not link:
            i += 1
            continue
        metadata = METADATA.fullmatch(lines[i + 1].rstrip('\r\n')) if i + 1 < len(lines) else None
        if not metadata:
            raise ValueError(f'Missing or malformed bookmark metadata on line {i + 2}.')
        url = check_url(link[2] or link[3])
        title = re.sub(r'\\(.)', r'\1', link[1])
        tag_text = metadata[2].strip()
        if any(not t.startswith('#') for t in tag_text.split()):
            raise ValueError(f'Malformed tags on line {i + 2}.')
        end = i + 2
        while end < len(lines):
            if lines[end].startswith(('  ', '\t')):
                end += 1
            elif not lines[end].strip():
                following = end + 1
                while following < len(lines) and not lines[following].strip():
                    following += 1
                if following < len(lines) and lines[following].startswith(('  ', '\t')):
                    end = following
                else:
                    break
            else:
                break
        notes = ''.join(lines[i + 2:end])
        deleted = notes.startswith(DELETED_NOTICE)
        entries.append(Entry(url, title, metadata[1], tags_from(','.join(tag_text.split())),
                             deleted, notes.removeprefix(DELETED_NOTICE), offsets[i], offsets[end]))
        i = end
    return entries


def read():
    return FILE.read_text() if FILE.exists() else HEADER


def save(original, updated):
    FILE.parent.mkdir(parents=True, exist_ok=True)
    if read() != original:
        raise ValueError('The note changed while the menu was open. Please retry.')
    mode = FILE.stat().st_mode & 0o777 if FILE.exists() else 0o600
    fd, name = tempfile.mkstemp(prefix='.tabber-', suffix='.tmp', dir=FILE.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(updated)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(name, mode)
        if read() != original:
            raise ValueError('The note changed while saving. Please retry.')
        os.replace(name, FILE)
    finally:
        if os.path.exists(name):
            os.unlink(name)


@contextmanager
def lock():
    # Held only around writes, never while waiting for a menu or network request.
    import hashlib
    directory = Path(os.environ.get('XDG_STATE_HOME', str(USER_HOME / '.local/state'))) / 'tabber'
    directory.mkdir(parents=True, exist_ok=True)
    name = hashlib.sha256(str(FILE.resolve()).encode()).hexdigest() + '.lock'
    with (directory / name).open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def menu(prompt, choices=(), current=None, index=False):
    args = ['rofi', '-i', '-dmenu', '-p', prompt]
    if current is not None:
        args += ['-filter', current]
    if index:
        args += ['-format', 'i', '-no-custom']
    result = subprocess.run(args, input='\n'.join(choices) + '\n', text=True, capture_output=True)
    if result.returncode != 0:
        raise Cancelled()
    return result.stdout.rstrip('\n')


def notify(message):
    print(message)
    try:
        subprocess.run(['notify-send', 'Tabber', message], check=False)
    except FileNotFoundError:
        pass


def duplicate(entries, url, excluding=None):
    for entry in entries:
        if not entry.deleted and entry.url == url and entry is not excluding:
            raise ValueError(f'URL already stored: {entry.title} ({entry.added})')


class PageTitle(HTMLParser):
    def __init__(self):
        super().__init__()
        self.inside = False
        self.parts = []

    def handle_starttag(self, tag, attrs):
        if tag == 'title':
            self.inside = True

    def handle_endtag(self, tag):
        if tag == 'title':
            self.inside = False

    def handle_data(self, data):
        if self.inside:
            self.parts.append(data)


def page_title(url):
    fetch = re.sub(r'^(https?://)(?:www\.)?reddit\.com(?=/|$)', r'\1old.reddit.com', url)
    result = subprocess.run(['curl', '-fsSL', '--compressed', '--max-time', '15',
                             '-A', 'Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0',
                             '-H', 'Accept-Language: en-US,en;q=0.9', fetch], capture_output=True)
    parser = PageTitle()
    if result.returncode == 0:
        parser.feed(result.stdout.decode('utf-8', errors='replace'))
    return clean(' '.join(parser.parts)) or 'Untitled'


def store():
    url = check_url(subprocess.run(['wl-paste', '--no-newline'], capture_output=True, text=True, check=True).stdout.strip())
    duplicate(parse(read()), url)
    kind = menu('Type:', ['todo', 'archive'])
    if kind not in ('todo', 'archive'):
        raise ValueError('Choose todo or archive.')
    tags = tags_from(menu('Tags (comma separated, optional):'))
    tags = [t for t in tags if t.lower() not in ('todo', 'archive')] + [kind]
    print('Fetching page title...')
    title = page_title(url)
    if title in ('Untitled', 'Welcome to Reddit', 'Just a moment...', 'Please wait for verification'):
        title = clean(menu('Title:', [title], current=title)) or 'Untitled'
    entry = Entry(url, title, date.today().isoformat(), tags)
    with lock():
        original = read()
        duplicate(parse(original), url)
        position = original.find('\n## Deleted entries\n')
        if position < 0:
            position = len(original)
        updated = original[:position].rstrip('\n') + '\n\n' + render(entry) + '\n' + original[position:]
        save(original, updated)
    notify(f'Tab stored: {title}')


def select(entries, prompt, filter_by='both'):
    entries = [e for e in reversed(entries) if not e.deleted and
               (filter_by == 'both' or filter_by in [t.lower() for t in e.tags])]
    if not entries:
        raise ValueError('No matching active tabs found.')
    choices = [f'{e.title} | {e.url} | {e.added} | {",".join(e.tags)}' for e in entries]
    selection = menu(prompt, choices, index=True)
    if not selection:
        raise Cancelled()
    index = int(selection)
    if not 0 <= index < len(entries):
        raise ValueError('Invalid selection.')
    return entries[index]


def find(filter_by):
    filter_by = filter_by or menu('Show which tabs:', ['both', 'todo', 'archive'])
    if filter_by not in ('both', 'todo', 'archive'):
        raise ValueError('Choose both, todo or archive.')
    entry = select(parse(read()), 'Select tab:', filter_by)
    subprocess.run(['wl-copy'], input=entry.url, text=True, check=True)
    print(f'URL copied to clipboard: {entry.url}')


def change(command):
    original = read()
    entries = parse(original)
    entry = select(entries, f'Select tab to {command}:')
    if command == 'delete':
        entry.deleted = True
    else:
        entry.url = check_url(menu('URL:', [entry.url], current=entry.url).strip())
        duplicate(entries, entry.url, excluding=entry)
        entry.title = clean(menu('Title:', [entry.title], current=entry.title))
        if not entry.title:
            raise ValueError('Title cannot be empty.')
        tags = ','.join(entry.tags)
        entry.tags = tags_from(menu('Tags (comma separated):', [tags], current=tags))
    with lock():
        save(original, original[:entry.start] + render(entry) + original[entry.end:])
    notify('Tab marked as deleted' if command == 'delete' else f'Tab updated: {entry.title}')


def prune():
    with lock():
        original = read()
        deleted = [e for e in parse(original) if e.deleted]
        updated = original
        for entry in reversed(deleted):
            updated = updated[:entry.start] + updated[entry.end:]
        if deleted:
            save(original, updated)
    notify(f'Pruned {len(deleted)} deleted entries')


def main():
    parser = argparse.ArgumentParser(description=f'Interactive bookmarks in {FILE}. Bookmarks are matched by URL. Deleted entries are visibly labeled until pruned.')
    parser.add_argument('command', choices=['store', 'find', 'edit', 'delete', 'prune', 'help'])
    parser.add_argument('filter', nargs='?', choices=['todo', 'archive', 'both'])
    args = parser.parse_args()
    try:
        if args.command == 'help':
            parser.print_help()
        elif args.command == 'store':
            store()
        elif args.command == 'find':
            find(args.filter)
        elif args.command in ('edit', 'delete'):
            change(args.command)
        else:
            prune()
    except Cancelled:
        print('Operation cancelled')
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        notify(f'Error: {error}')
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
