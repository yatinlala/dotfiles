#!/usr/bin/env python3
"""Save Kitty terminal transcripts and reopen them in fresh shells."""

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import uuid


SCRIPT = str(Path(__file__).resolve())
SGR = re.compile(r"\x1b\[[0-9:;]*m")
ANSI = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]"
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
    r"|\x1b[P_X^].*?\x1b\\"
    r"|\x1b[ -/]*[@-Z\\-_]",
    re.DOTALL,
)
RESET = "\x1b[0m"


def state_dir():
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    return Path(os.environ.get("SM_MINI_DIR") or base / "sm-mini").expanduser().resolve()


def plain(text):
    text = ANSI.sub("", text)
    return "".join(c for c in text if c in "\n\t" or (c.isprintable()))


def formatted(text):
    """Keep color/style (SGR) codes, omitting other terminal controls."""
    parts = []
    start = 0
    for match in ANSI.finditer(text):
        parts.append(plain(text[start:match.start()]))
        if SGR.fullmatch(match.group()):
            parts.append(match.group())
        start = match.end()
    parts.append(plain(text[start:]))
    return "".join(parts)


def one_line(text):
    return " ".join(plain(text).split())


def remote(*args):
    address = os.environ.get("KITTY_LISTEN_ON", "")
    fds = (int(address[3:]),) if address.startswith("fd:") else ()
    result = subprocess.run(["kitten", "@", *args], capture_output=True,
                            text=True, pass_fds=fds)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Kitty remote control failed")
    return result.stdout


def read_entry(path):
    entry = json.loads(path.read_text())
    if entry.get("version") != 1 or any(
        not isinstance(entry.get(key), str)
        for key in ("cwd", "title", "saved_at", "text")
    ) or not Path(entry["cwd"]).is_absolute():
        raise ValueError(f"Invalid snapshot: {path}")
    return entry


def entries():
    result = []
    for path in sorted(state_dir().glob("*.json"), reverse=True):
        try:
            result.append((path, read_entry(path)))
        except (OSError, ValueError, TypeError, AttributeError) as error:
            print(f"Skipping {path.name}: {error}", file=sys.stderr)
    return result


def save(args):
    match = "all" if args.all else "id:" + str(
        args.window_id or os.environ.get("KITTY_WINDOW_ID", "")
    )
    if match == "id:":
        raise RuntimeError("Run save inside Kitty, or pass --window-id ID.")
    tree = json.loads(remote("ls", "--match", match))
    windows = [w for host in tree for tab in host["tabs"] for w in tab["windows"]]
    if not windows:
        raise RuntimeError("No matching Kitty windows.")
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    failures = []
    for window in windows:
        temporary = None
        try:
            cwd = window.get("cwd", "")
            if not cwd or not Path(cwd).is_absolute():
                raise RuntimeError("Kitty did not report an absolute working directory")
            text = remote("get-text", "--match", f"id:{window['id']}", "--extent", "all", "--ansi")
            now = datetime.now(timezone.utc)
            entry = dict(version=1, cwd=cwd, title=args.name or window.get("title", ""),
                         saved_at=now.isoformat(timespec="seconds"), text=formatted(text))
            ident = now.strftime("%Y%m%dT%H%M%S%fZ") + "-" + uuid.uuid4().hex[:8]
            target = directory / (ident + ".json")
            with tempfile.NamedTemporaryFile(mode="w", dir=directory, prefix=".saving-",
                                             delete=False, encoding="utf-8") as stream:
                temporary = Path(stream.name)
                json.dump(entry, stream, ensure_ascii=False)
                stream.flush()
                os.fsync(stream.fileno())
            temporary.replace(target)
            print(f"Saved {ident}: {one_line(entry['title'])} ({one_line(cwd)})")
        except (OSError, RuntimeError) as error:
            failures.append(f"Window {window['id']}: {error}")
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
    if failures:
        raise RuntimeError("\n".join(failures))
    return len(windows)


def picker_rows(saved):
    return [f"{path.stem}\t{entry['saved_at']}  {one_line(entry['title'])}  {one_line(entry['cwd'])}"
            for path, entry in saved]


def pick(saved):
    if not shutil.which("fzfwp"):
        raise RuntimeError("Install fzfwp (and fzf) to use the picker.")
    rows = picker_rows(saved)
    preview = shlex.join([sys.executable, SCRIPT, "_preview"]) + " {1}"
    delete = shlex.join([sys.executable, SCRIPT, "forget"]) + " {1} >/dev/null"
    refresh = shlex.join([sys.executable, SCRIPT, "_rows"])
    env = os.environ.copy()
    env["SM_MINI_DIR"] = str(state_dir())
    result = subprocess.run(
        ["fzfwp", "--no-multi", "--delimiter=\t", "--with-nth=2..", "--prompt=Restore> ",
         "--preview", preview, "--preview-window=right:60%:wrap:nohidden",
         "--header=Enter: restore | Delete: delete snapshot | Esc: close",
         f"--bind=delete:reload-sync({delete}; {refresh})"],
        input="\n".join(rows) + "\n", text=True, stdout=subprocess.PIPE, env=env)
    if result.returncode in (1, 130):
        return []
    if result.returncode:
        raise RuntimeError(f"fzfwp exited with status {result.returncode}")
    ident = result.stdout.split("\t", 1)[0].strip()
    return [(path, entry) for path, entry in entries() if path.stem == ident]


def restore(saved):
    failures = []
    shell = os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/sh"
    for path, entry in saved:
        try:
            if not Path(entry["cwd"]).is_dir():
                raise RuntimeError(f"Directory no longer exists: {entry['cwd']}")
            remote("launch", "--type=os-window", f"--cwd={entry['cwd']}",
                   "--os-window-class=kitty",
                   sys.executable, SCRIPT, "_replay", str(path), shell)
            print(f"Restored {one_line(entry['title'])} ({one_line(entry['cwd'])})")
        except (OSError, RuntimeError) as error:
            failures.append(f"{path.stem}: {error}")
    if failures:
        raise RuntimeError("\n".join(failures))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    saving = commands.add_parser("save", help="Save the current Kitty terminal")
    saving.add_argument("name", nargs="?", help="Optional reminder/name")
    group = saving.add_mutually_exclusive_group()
    group.add_argument("--all", action="store_true", help="Save all windows in this Kitty instance")
    group.add_argument("--window-id", type=int, help="Kitty window ID (for keybindings)")
    commands.add_parser("reload", help="Pick a snapshot with fzf and open a new OS window")
    commands.add_parser("all", help="Open every saved snapshot in a new OS window")
    commands.add_parser("list", help="List saved snapshots")
    commands.add_parser("_rows", help="Internal: list picker rows")
    forgetting = commands.add_parser("forget", help="Delete one snapshot by ID")
    forgetting.add_argument("id")
    preview = commands.add_parser("_preview", help="Internal: preview a snapshot")
    preview.add_argument("id")
    replay = commands.add_parser("_replay", help="Internal: print a snapshot and start the shell")
    replay.add_argument("path")
    replay.add_argument("shell")
    args = parser.parse_args()
    if args.command == "save":
        save(args)
    elif args.command == "_rows":
        for row in picker_rows(entries()):
            print(row)
    elif args.command == "_replay":
        entry = read_entry(Path(args.path))
        os.chdir(entry["cwd"])
        print(formatted(entry["text"]), end="")
        print(f"{RESET}\n--- Restored snapshot from {one_line(entry['saved_at'])} ---\n", flush=True)
        os.execv(args.shell, [args.shell, "-i"])
    elif args.command in ("_preview", "forget"):
        if not re.fullmatch(r"[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}", args.id):
            raise RuntimeError("Invalid snapshot ID; use sm-mini list.")
        path = state_dir() / (args.id + ".json")
        if args.command == "forget":
            path.unlink()
            print(f"Deleted {args.id}")
        else:
            entry = read_entry(path)
            # Keep preceding style codes intact; slicing the tail can lose the
            # active color or split an escape sequence. fzf renders ANSI previews.
            print(formatted(entry["text"]) + RESET)
    else:
        saved = entries()
        if not saved:
            print("No saved snapshots. Run sm-mini save first.")
        elif args.command == "list":
            for path, entry in saved:
                print(f"{path.stem}\t{one_line(entry['title'])}\t{one_line(entry['cwd'])}")
        else:
            restore(pick(saved) if args.command == "reload" else saved)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        print(f"sm-mini: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
