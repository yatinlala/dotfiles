// Shared settings live in common.jsonc; per-output module lists live here.
[
  {
    "output": "!moreland",
    "include": [
      "~/.config/waybar/common.jsonc"
    ],
    "modules-right": [
      // "custom/eye",
      "power-profiles-daemon",
      "privacy",
      "idle_inhibitor",
      "custom/weather",
      "custom/charge_threshold",
      "mpd",
      // "custom/todo",
      "custom/scratchpad_tracking",
      "tray",
      "backlight",
      "wireplumber",
      "bluetooth",
      "network",
      "clock#date",
      "clock#time",
      "battery"
    ]
  },
  {
    "output": "moreland",
    "include": [
      "~/.config/waybar/common.jsonc"
    ],
    "modules-right": [
      "custom/weather",
      "power-profiles-daemon",
      "privacy",
      "idle_inhibitor",
      "custom/charge_threshold",
      "mpd",
      "custom/scratchpad_tracking",
      "tray",
      "wireplumber",
      "bluetooth",
      "network",
      "battery"
    ]
  }
]
